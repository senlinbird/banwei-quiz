# ===== 班味浓度检测 环境变量配置 =====
# 复制本文件为 .env 并修改后使用（.env 已被服务端自动读取，优先级低于真实环境变量）

# 服务端口
PORT=3000

# 管理后台登录密码（务必修改！不设置则默认 admin123 并打印警告）
ADMIN_PASSWORD=please-change-me-2026

# 管理员会话签名密钥（务必修改！随机长字符串即可）
SESSION_SECRET=change-me-to-a-long-random-string

# 数据目录（默认 ./data）
# DATA_DIR=./data

# 新密码默认可用次数（管理后台生成时可覆盖）
# MAX_ATTEMPTS=3
